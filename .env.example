# Copy this template to .env and fill in your API key(s) as needed.
# The .env file is git-ignored to prevent leaking credentials.
# Only provide keys for the provider(s) you intend to use.

# ===== Active Default Provider in config.yaml =====
# Groq - Fast LLM inference with free-tier access. Get key: https://console.groq.com
GROQ_API_KEY=gsk_...
# ROTATION: Supply multiple keys separated by commas for automated load balancing:
#   GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
# GROQ_API_KEY_2=gsk_...

# ===== Other Providers (via `preset` in config.yaml rotation list) =====
# Each line corresponds to a built-in preset with the same name.
GEMINI_API_KEY=...           # preset: gemini      https://aistudio.google.com
OPENROUTER_API_KEY=sk-or-... # preset: openrouter  https://openrouter.ai (free models available)
CEREBRAS_API_KEY=csk-...     # preset: cerebras    https://cloud.cerebras.ai
TOGETHER_API_KEY=...         # preset: together    https://api.together.ai
DEEPSEEK_API_KEY=sk-...      # preset: deepseek    https://platform.deepseek.com
MISTRAL_API_KEY=...          # preset: mistral     https://console.mistral.ai
XAI_API_KEY=xai-...          # preset: xai (Grok)  https://console.x.ai
FIREWORKS_API_KEY=fw_...     # preset: fireworks   https://fireworks.ai
PERPLEXITY_API_KEY=pplx-...  # preset: perplexity  https://www.perplexity.ai/settings/api
OPENAI_API_KEY=sk-...        # preset: openai      https://platform.openai.com
ANTHROPIC_API_KEY=sk-ant-... # preset: anthropic (Claude)  https://console.anthropic.com

# Local offline Ollama does NOT require any API keys.
